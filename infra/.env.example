# Copy this file to infra/.env and fill in real values before running docker compose.
# Never commit the real .env.

# --- PostgreSQL (single database, service-owned schemas) ---
POSTGRES_USER=feed_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feed

# --- Neo4j ---
# NEO4J_AUTH must be user/password. NEO4J_PASSWORD is used by the seed container.
NEO4J_AUTH=neo4j/feedpassword
NEO4J_PASSWORD=feedpassword

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=feed_user
RABBITMQ_DEFAULT_PASS=changeme

# --- Connection URLs used by the shared library and services ---
# Host-side (tests run outside Docker); services inside the network use the container names.
DATABASE_URL=postgresql://feed_user:changeme@localhost:5432/feed
NEO4J_URI=bolt://localhost:7687
RABBITMQ_URL=amqp://feed_user:changeme@localhost:5672/

# --- LLM gateway (provider-configurable; M1 uses it only for Cleansing) ---
# LLM_PROVIDER selects the wire protocol/adapter ("openai" = OpenAI-compatible, which covers Kimi).
# LLM_BASE_URL points at any OpenAI-compatible endpoint; leave empty to use the provider default.
# LLM_API_KEY is the single API key (set it only in infra/.env; never commit a real key).
LLM_PROVIDER=openai
LLM_MODEL=<provider-model-id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
