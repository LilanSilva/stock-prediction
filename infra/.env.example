# Copy this file to infra/.env and fill in real values before running docker compose.
# Never commit the real .env.

# --- PostgreSQL (single database, service-owned schemas) ---
POSTGRES_USER=feed_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feed

# --- Neo4j ---
# NEO4J_AUTH must be user/password. NEO4J_PASSWORD is used by the seed container.
NEO4J_AUTH=neo4j/feedpassword
NEO4J_PASSWORD=feedpassword

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=feed_user
RABBITMQ_DEFAULT_PASS=changeme

# --- Connection URLs used by the shared library and services ---
# Host-side (tests run outside Docker); services inside the network use the container names.
DATABASE_URL=postgresql://feed_user:changeme@localhost:5432/feed
NEO4J_URI=bolt://localhost:7687
RABBITMQ_URL=amqp://feed_user:changeme@localhost:5672/

# --- LLM gateway (provider-configurable; M1 uses it only for Cleansing) ---
# LLM_PROVIDER selects the wire protocol/adapter ("openai" = OpenAI-compatible, which covers Kimi).
# LLM_BASE_URL points at any OpenAI-compatible endpoint; leave empty to use the provider default.
# LLM_API_KEY is the single API key (set it only in infra/.env; never commit a real key).
LLM_PROVIDER=openai
LLM_MODEL=<provider-model-id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=30

# --- FreeNewsApi.io (Ingestion news source; POC-8, replaces GDELT) ---
# Free key from https://freenewsapi.io (no billing). Set it only in infra/.env; never commit a real
# key. Empty disables the source, and the four Swedish RSS feeds still run.
FREENEWSAPI_KEY=

# --- Ingestion polling ---
# News read frequency in seconds. Default 3600 (hourly). 900 = 15 min. Only freenewsapi counts
# against its 5,000 req/day cap: worst case req/day = (86400/interval) * (keywords + keywords*page_size).
# 900s ~= 2,880/day (~58%). Do not go below ~600s (10 min ~= 86%) without trimming keywords/page_size.
INGESTION_POLL_INTERVAL_SECONDS=3600

# --- Credibility offline structure learner ---
# Set CREDIBILITY_LEARNING_ENABLED=false to disable the in-process scheduler and rely only on
# manual CLI runs (python -m credibility.learning.run).
CREDIBILITY_LEARNING_ENABLED=true
CREDIBILITY_LEARNING_INTERVAL_HOURS=24
# Days of closing prices used to compute per-asset historical daily volatility.
CREDIBILITY_LEARNING_VOLATILITY_LOOKBACK_DAYS=30
# A price move is considered abnormal when |actual_return| >= threshold * historical_volatility.
# An abnormal sample lowers the evidence bar from min_samples to ABNORMAL_MIN_SAMPLES (not to 1:
# the learner only creates edges, but one observation is too thin to act on).
CREDIBILITY_LEARNING_ABNORMAL_THRESHOLD=2.0
CREDIBILITY_LEARNING_ABNORMAL_MIN_SAMPLES=2

# --- Credibility: KG edge weight learning ---
# One scored prediction moves the fired edge's weight by WEIGHT_STEP scaled by that edge's credit
# share: up when the prediction was correct, down when it was wrong. Clamped to [WEIGHT_FLOOR, 1.0],
# so an expert-asserted edge degrades only under sustained evidence and becomes negligible rather
# than vanishing. Edge alpha/beta are frozen; weight is the learned quantity.
CREDIBILITY_WEIGHT_STEP=0.02
CREDIBILITY_WEIGHT_FLOOR=0.05

# --- Prediction decision policy ---
# Below this confidence the decision is NEUTRAL ("no move expected"), which is the correct answer
# for roughly a quarter of outcomes. Applies to the evidence-weighted confidence, not a bare
# agreement ratio.
PREDICTION_DECISION_DEADBAND=0.15
# Evidence half-point: total firing-edge strength equal to this yields a confidence mass of 0.5.
# Lower makes the system more confident on thin evidence.
PREDICTION_CONFIDENCE_EVIDENCE_HALFPOINT=0.5
# Stances per asset per local trading day. A second one is emitted only when the direction flips, so
# the cap is reached at two opposing calls. Non-trading days always collapse to a single stance.
PREDICTION_MAX_DAILY_PREDICTIONS_PER_ASSET=2

# Optional research evidence capture; OFF or CAPTURE. Does not train or activate a model.
PREDICTION_RESEARCH_MODE=OFF
PREDICTION_RESEARCH_CAPTURE_TIMEOUT_SECONDS=1.0

# --- Notification service ---
# Confidence gate: predictions below this value are discarded (0.0–1.0).
NOTIFICATION_MIN_CONFIDENCE=0.6
# Set to true to enable verification (scored-prediction) alerts. Disabled by default.
NOTIFICATION_VERIFICATION_ALERTS_ENABLED=false
# Brevo transactional email (https://brevo.com). Leave empty to disable email channel.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Feed Analyzer"
# Meta Cloud API WhatsApp (https://developers.facebook.com/docs/whatsapp/cloud-api).
# Leave empty to disable WhatsApp channel.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v18.0
# Templates must be approved in the sender's WhatsApp Business Account before sending.
META_PREDICTION_TEMPLATE=feed_prediction_alert_v1
META_VERIFICATION_TEMPLATE=feed_verification_alert_v1
META_TEMPLATE_LANGUAGE=en_US

# --- Intraday verification (OFF until provider coverage is validated) ---
VERIFICATION_INTRADAY_MODE=OFF
VERIFICATION_INTRADAY_PRICE_POLICY=LAST_KNOWN_PRICE_V1
# JSON map of canonical asset ids to exchange_calendars names, e.g. {"LMT_NYSE":"XNYS"}.
# An empty map enables no assets. Use the actual listing's calendar, never just its timezone.
VERIFICATION_INTRADAY_CALENDARS={}
VERIFICATION_INTRADAY_TARGET_RETURN=0.003
VERIFICATION_INTRADAY_NEUTRAL_BAND=0.003
MARKET_DATA_INTRADAY_ENABLED=false
MARKET_DATA_INTRADAY_POLL_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Avanza snapshots (collected inside feed-market-data) ---
MARKET_DATA_SOURCE=avanza_first
# Rollout and recovery instructions: requirements/SRS-05-market-data.md
SNAPSHOT_ENABLED=false
SNAPSHOT_CONCURRENCY=2
SNAPSHOT_INTERVAL_SECONDS=600
VERIFICATION_SAMPLE_MODE=OFF
VERIFICATION_SAMPLE_CALENDARS={}
VERIFICATION_SAMPLE_TARGET_RETURN=0.003
VERIFICATION_SAMPLE_NEUTRAL_BAND=0.003

# Evidence policy; see SRS-03. Strict modes are evaluation options, not the default.
CLEANSING_CLASSIFICATION_MODE=title_first

# --- Standalone LLM Browser Gateway (host or optional Docker profile) ---
# Setup, supported fields and recovery: requirements/SRS-11-llm-browser-gateway.md
# Fill required values only in ignored infra/.env. Use distinct random keys of >=24 characters.
BROWSER_GATEWAY_API_KEY=
BROWSER_GATEWAY_PAIRING_KEY=
# Host-mode DSN; Docker Compose instead uses POSTGRES_* and feed-postgres.
# The gateway owns only schema llm_browser_gateway.
BROWSER_GATEWAY_DATABASE_URL=
# Copy the ID displayed by Chrome after loading extension/dist as an unpacked extension.
BROWSER_GATEWAY_EXTENSION_ID=
BROWSER_GATEWAY_PROFILE_ID=default
BROWSER_GATEWAY_PRIORITY=chatgpt,claude
BROWSER_GATEWAY_TABS_PER_PROVIDER=2
BROWSER_GATEWAY_MODEL_ALIAS=browser-auto
BROWSER_GATEWAY_DEADLINE_SECONDS=180
BROWSER_GATEWAY_RETRY_SECONDS=900
BROWSER_GATEWAY_QUEUE_SIZE=16
BROWSER_GATEWAY_MAX_BODY_BYTES=262144
BROWSER_GATEWAY_RETENTION_DAYS=7
# Compose sets deployment=container, host=0.0.0.0 and port=8091 internally,
# publishing only 127.0.0.1:8091. Leave host-mode defaults unchanged here.
